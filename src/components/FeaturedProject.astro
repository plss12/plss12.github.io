---
import { routes, useTranslations, type Locale, type Localized } from '@/i18n';
import { featuredProject as project } from '@/data/projects';
import LunarRoutes from '@/components/visuals/LunarRoutes.astro';
import TrainingChart from '@/components/visuals/TrainingChart.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* La conclusión técnica del TFM, en dos frases: es la parte que más dice del criterio del autor. */
const insight = {
  title: { es: 'Por qué un algoritmo aprendió y el otro no', en: 'Why one algorithm learned and the other didn’t' },
  body: {
    es: 'DDDQL es off-policy: reutiliza miles de experiencias pasadas de todos los rovers y se adapta a mapas que cambian en cada episodio. MAPPO es on-policy y solo aprende de la política actual, así que la aleatoriedad del entorno le impidió converger.',
    en: 'DDDQL is off-policy: it reuses thousands of past experiences from every rover and copes with maps that change every episode. MAPPO is on-policy and only learns from its current policy, so the environment’s randomness kept it from converging.',
  },
} satisfies Record<string, Localized>;
---

<article class="featured" aria-labelledby="featured-title">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5 lg:pt-4">
      <p class="text-base font-semibold">
        {project.name}
        <span class="block font-normal text-muted">{project.context[locale]}</span>
      </p>
      <h3 id="featured-title" class="text-title mt-6">{project.tagline[locale]}</h3>
      <p class="mt-6 max-w-prose text-muted">{project.summary[locale]}</p>

      <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-line pt-6">
        {
          project.facts.map((fact) => (
            <div class="flex flex-col-reverse justify-end gap-1">
              <dt class="text-sm text-muted">{fact.label[locale]}</dt>
              <dd class="text-subtitle">{fact.value[locale]}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={routes.caseStudy(locale, project.slug)} class="btn bg-ink text-bg">{t('cta.caseStudy')}</a>
        {project.links.map((link) => <a href={link.href} class="link font-semibold">{link.label[locale]}</a>)}
      </p>
    </div>

    <figure class="lg:col-span-7">
      <LunarRoutes locale={locale} />
    </figure>
  </div>

  <div class="mt-20 grid gap-12 lg:mt-24 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5 lg:pt-4">
      <h4 class="text-subtitle">{insight.title[locale]}</h4>
      <p class="mt-4 max-w-prose text-muted">{insight.body[locale]}</p>
    </div>
    <div class="lg:col-span-7">
      <TrainingChart locale={locale} />
    </div>
  </div>
</article>
