---
/*
 * Las cuatro fases de Monte Carlo Tree Search, el algoritmo base de pyplAI,
 * redibujadas con el estilo de la web en una cuadrícula de 2 × 2.
 */
import type { Locale, Localized } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const phases: Localized[] = [
  { es: '1. Selección', en: '1. Selection' },
  { es: '2. Expansión', en: '2. Expansion' },
  { es: '3. Simulación', en: '3. Simulation' },
  { es: '4. Retropropagación', en: '4. Backpropagation' },
];

type P = { x: number; y: number };
/* Árbol común: raíz, dos hijos y dos nietos; el camino elegido baja por la izquierda. */
const nodes = {
  root: { x: 80, y: 12 },
  a: { x: 56, y: 42 },
  b: { x: 104, y: 42 },
  a1: { x: 38, y: 72 },
  a2: { x: 74, y: 72 },
} satisfies Record<string, P>;
type NodeKey = keyof typeof nodes;
const edges: [NodeKey, NodeKey][] = [
  ['root', 'a'],
  ['root', 'b'],
  ['a', 'a1'],
  ['a', 'a2'],
];
const onPath = new Set(['root-a', 'a-a2']);
const pathNodes = new Set<NodeKey>(['root', 'a', 'a2']);
const leaf: P = { x: 92, y: 102 };
const terminal: P = { x: 92, y: 130 };

const R = 7;
const W = 166;
const H = 166;
const GAP_X = 10;
const GAP_Y = 12;
const LABEL_Y = H - 6;

/* Flecha de retropropagación: paralela a la rama, desplazada a la derecha y apuntando al padre. */
function backArrow(child: P, parent: P) {
  const dx = parent.x - child.x;
  const dy = parent.y - child.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const nx = -uy;
  const ny = ux;
  const off = 10;
  const trim = R + 3;
  const sx = child.x + ux * trim + nx * off;
  const sy = child.y + uy * trim + ny * off;
  const ex = parent.x - ux * trim + nx * off;
  const ey = parent.y - uy * trim + ny * off;
  return `M${sx.toFixed(1)},${sy.toFixed(1)} L${ex.toFixed(1)},${ey.toFixed(1)}`;
}

const text = {
  title: { es: 'Las cuatro fases de Monte Carlo Tree Search', en: 'The four phases of Monte Carlo Tree Search' },
  desc: {
    es: 'Selección: se baja por el árbol eligiendo los nodos más prometedores. Expansión: se añade un nodo nuevo. Simulación: se juega una partida rápida hasta el final. Retropropagación: el resultado sube por el camino y actualiza las estadísticas de cada nodo.',
    en: 'Selection: walk down the tree picking the most promising nodes. Expansion: add a new node. Simulation: play a quick game to the end. Backpropagation: the result travels back up the path and updates each node’s statistics.',
  },
} satisfies Record<string, Localized>;
const id = `mcts-${locale}`;
---

<svg
  viewBox={`0 0 ${W * 2 + GAP_X} ${H * 2 + GAP_Y}`}
  role="img"
  aria-labelledby={`${id}-title ${id}-desc`}
  class="mx-auto block h-full max-h-full w-auto max-w-full"
>
  <title id={`${id}-title`}>{text.title[locale]}</title>
  <desc id={`${id}-desc`}>{text.desc[locale]}</desc>
  <defs>
    <marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M1,1 L8,5 L1,9" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </marker>
  </defs>
  {
    phases.map((phase, i) => (
      <g transform={`translate(${(i % 2) * (W + GAP_X)} ${Math.floor(i / 2) * (H + GAP_Y)})`}>
        {edges.map(([from, to]) => {
          const on = onPath.has(`${from}-${to}`);
          return (
            <line
              x1={nodes[from].x}
              y1={nodes[from].y}
              x2={nodes[to].x}
              y2={nodes[to].y}
              stroke={on ? 'var(--ink)' : 'var(--line)'}
              stroke-width={on ? 2.5 : 2}
            />
          );
        })}
        {i >= 1 && (
          <line
            x1={nodes.a2.x}
            y1={nodes.a2.y}
            x2={leaf.x}
            y2={leaf.y}
            stroke="var(--ink)"
            stroke-width="2.5"
            stroke-dasharray={i === 1 ? '4 4' : undefined}
          />
        )}
        {i === 2 && (
          <>
            <line
              x1={leaf.x}
              y1={leaf.y + R + 2}
              x2={terminal.x}
              y2={terminal.y - 7}
              stroke="var(--muted)"
              stroke-width="2"
              stroke-dasharray="1 5"
              stroke-linecap="round"
            />
            <rect x={terminal.x - 5} y={terminal.y - 5} width="10" height="10" rx="2" fill="var(--muted)" />
          </>
        )}
        {(Object.keys(nodes) as NodeKey[]).map((key) => {
          const on = pathNodes.has(key);
          return (
            <circle
              cx={nodes[key].x}
              cy={nodes[key].y}
              r={R}
              fill={on ? 'var(--ink)' : 'var(--bg)'}
              stroke={on ? 'var(--ink)' : 'var(--muted)'}
              stroke-width="2"
            />
          );
        })}
        {i >= 1 && (
          <circle
            cx={leaf.x}
            cy={leaf.y}
            r={R}
            fill={i === 1 ? 'var(--bg)' : 'var(--ink)'}
            stroke="var(--ink)"
            stroke-width="2"
            stroke-dasharray={i === 1 ? '3 3' : undefined}
          />
        )}
        {i === 3 && (
          <g fill="none" stroke="var(--ink)" stroke-width="1.75" stroke-linecap="round">
            {[
              [leaf, nodes.a2],
              [nodes.a2, nodes.a],
              [nodes.a, nodes.root],
            ].map(([child, parent]) => (
              <path d={backArrow(child!, parent!)} marker-end={`url(#${id}-arrow)`} />
            ))}
          </g>
        )}
        <text x={W / 2} y={LABEL_Y} text-anchor="middle" font-size="15" font-weight="600" fill="var(--ink)">
          {phase[locale]}
        </text>
      </g>
    ))
  }
</svg>
