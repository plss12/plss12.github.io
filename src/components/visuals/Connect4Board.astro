---
/*
 * Tablero de Conecta 4 con una victoria en diagonal. La posición es legal:
 * respeta la gravedad y el turno (7 fichas del primer jugador, 6 del segundo).
 */
import type { Locale, Localized } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COLS = 7;
const ROWS = 6;
/* Columnas de abajo arriba: 1 = agente (relleno), 2 = rival (anillo). */
/* Fichas ganadoras: anillo exterior para marcar la diagonal. */
const columns: (1 | 2)[][] = [[2], [1], [2, 1], [1, 2, 1], [2, 1, 2, 1], [2], [1]];

const C = 56;
const PAD = 14;
const W = COLS * C + PAD * 2;
const H = ROWS * C + PAD * 2;
const cx = (col: number) => PAD + col * C + C / 2;
const cy = (row: number) => PAD + (ROWS - 1 - row) * C + C / 2;

const text = {
  title: { es: 'Tablero de Conecta 4 con una victoria en diagonal', en: 'Connect 4 board with a diagonal win' },
  desc: {
    es: 'El agente, con fichas negras, conecta cuatro en diagonal de abajo a la izquierda hacia arriba a la derecha.',
    en: 'The agent, playing the solid pieces, connects four diagonally from bottom left to top right.',
  },
} satisfies Record<string, Localized>;
const id = `c4-${locale}`;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-title ${id}-desc`} class="block h-auto w-full">
  <title id={`${id}-title`}>{text.title[locale]}</title>
  <desc id={`${id}-desc`}>{text.desc[locale]}</desc>
  {
    Array.from({ length: COLS }, (_, col) =>
      Array.from({ length: ROWS }, (_, row) => {
        const piece = columns[col]?.[row];
        if (piece === 1) return <circle cx={cx(col)} cy={cy(row)} r={C * 0.38} fill="var(--ink)" />;
        if (piece === 2)
          return <circle cx={cx(col)} cy={cy(row)} r={C * 0.38 - 2} fill="none" stroke="var(--ink)" stroke-width="4" />;
        return <circle cx={cx(col)} cy={cy(row)} r={C * 0.38} fill="color-mix(in srgb, var(--ink) 8%, transparent)" />;
      }),
    )
  }
  {
    [
      [1, 0],
      [2, 1],
      [3, 2],
      [4, 3],
    ].map(([col, row]) => (
      <circle cx={cx(col!)} cy={cy(row!)} r={C * 0.38 + 5} fill="none" stroke="var(--ink)" stroke-width="2" />
    ))
  }
</svg>
