---
/*
 * Redibujo del primer entorno de prueba del TFM (figura 5.9) con el estilo de la web.
 * Los datos (mapa, obstáculos y rutas del modelo DDDQL entrenado) son los reales.
 */
import type { Locale, Localized } from '@/i18n';
import { base, grid, rovers, totalSteps, type Cell } from '@/data/lunar-scenario';

interface Props {
  locale: Locale;
  /** Muestra la leyenda completa (en la portada se usa una versión compacta). */
  legend?: boolean;
}

const { locale, legend = true } = Astro.props;

const SIZE = 40;
const GAP = 3;
const N = grid.length;
const VIEW = N * SIZE;
/* Cada rover se desplaza un poco dentro de la celda para que las rutas solapadas sigan viéndose. */
const offsets = [-6, 0, 6];
const series = ['var(--series-1)', 'var(--series-2)', 'var(--series-3)'];

const center = ([row, col]: Cell, offset = 0) => ({ x: col * SIZE + SIZE / 2 + offset, y: row * SIZE + SIZE / 2 + offset });
const points = (path: Cell[], offset: number) =>
  path.map((cell) => center(cell, offset)).map(({ x, y }) => `${x},${y}`).join(' ');

const cellFill: Record<string, string> = {
  '.': 'var(--surface)',
  s: 'color-mix(in srgb, var(--ink) 16%, var(--surface))',
  L: 'color-mix(in srgb, var(--ink) 62%, var(--surface))',
};

const text = {
  title: {
    es: 'Rutas reales de tres rovers en un mapa lunar de 12 por 12',
    en: 'Real routes of three rovers on a 12 by 12 lunar map',
  },
  desc: {
    es: `Cada rover sale de su posición, explora hasta encontrar su mina y lleva el mineral a la mezcladora común. Entre los tres suman ${totalSteps} pasos y no chocan en ningún momento. Las casillas gris claro son obstáculos pequeños y las oscuras, obstáculos grandes.`,
    en: `Each rover starts from its position, explores until it finds its mine and carries the ore to the shared mixer. Together they take ${totalSteps} steps without a single collision. Light grey squares are small obstacles and dark ones are large obstacles.`,
  },
  rover: { es: 'Rover', en: 'Rover' },
  steps: { es: 'pasos', en: 'steps' },
  start: { es: 'Salida', en: 'Start' },
  mine: { es: 'Mina', en: 'Mine' },
  base: { es: 'Mezcladora', en: 'Mixer' },
  small: { es: 'Obstáculo pequeño', en: 'Small obstacle' },
  large: { es: 'Obstáculo grande', en: 'Large obstacle' },
} satisfies Record<string, Localized>;

const id = `lunar-${locale}`;
const b = center(base);
---

<div class="lunar">
  <svg viewBox={`0 0 ${VIEW} ${VIEW}`} role="img" aria-labelledby={`${id}-title ${id}-desc`} class="block h-auto w-full">
    <title id={`${id}-title`}>{text.title[locale]}</title>
    <desc id={`${id}-desc`}>{text.desc[locale]}</desc>

    <g>
      {
        grid.map((row, r) =>
          [...row].map((kind, c) => (
            <rect
              x={c * SIZE + GAP / 2}
              y={r * SIZE + GAP / 2}
              width={SIZE - GAP}
              height={SIZE - GAP}
              rx="4"
              fill={cellFill[kind]}
            />
          )),
        )
      }
    </g>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      {rovers.map((rover, i) => <polyline points={points(rover.path, offsets[i] ?? 0)} stroke={series[i]} stroke-width="3" />)}
    </g>

    <g>
      {
        rovers.map((rover, i) => {
          const s = center(rover.start);
          const m = center(rover.mine);
          return (
            <>
              <rect x={m.x - 9} y={m.y - 9} width="18" height="18" rx="3" transform={`rotate(45 ${m.x} ${m.y})`} fill="var(--bg)" stroke={series[i]} stroke-width="3" />
              <circle cx={s.x} cy={s.y} r="11" fill={series[i]} stroke="var(--bg)" stroke-width="3" />
              <text x={s.x} y={s.y + 4.5} text-anchor="middle" font-size="13" font-weight="700" fill="#fff">
                {i + 1}
              </text>
            </>
          );
        })
      }
      <rect x={b.x - 13} y={b.y - 13} width="26" height="26" rx="6" fill="var(--ink)" stroke="var(--bg)" stroke-width="3" />
    </g>
  </svg>

  {
    legend && (
      <div class="mt-5 grid gap-x-8 gap-y-3 text-sm text-muted sm:grid-cols-2">
        <ul class="grid gap-2" role="list">
          {rovers.map((rover, i) => (
            <li class="flex items-center gap-3">
              <span class="h-[3px] w-6 rounded-full" style={`background:${series[i]}`} aria-hidden="true" />
              <span>
                <span class="font-semibold text-ink">
                  {text.rover[locale]} {i + 1}
                </span>{' '}
                {rover.path.length - 1} {text.steps[locale]}
              </span>
            </li>
          ))}
        </ul>
        <ul class="grid gap-2" role="list">
          <li class="flex items-center gap-3">
            <span class="size-3 rounded-full bg-muted" aria-hidden="true" />
            {text.start[locale]}
          </li>
          <li class="flex items-center gap-3">
            <span class="size-2.5 rotate-45 rounded-[2px] border-2 border-muted" aria-hidden="true" />
            {text.mine[locale]}
          </li>
          <li class="flex items-center gap-3">
            <span class="size-3 rounded-[3px] bg-ink" aria-hidden="true" />
            {text.base[locale]}
          </li>
          <li class="flex items-center gap-3">
            <span class="size-3 rounded-[3px]" style="background:color-mix(in srgb, var(--ink) 16%, var(--surface))" aria-hidden="true" />
            {text.small[locale]}
          </li>
          <li class="flex items-center gap-3">
            <span class="size-3 rounded-[3px]" style="background:color-mix(in srgb, var(--ink) 62%, var(--surface))" aria-hidden="true" />
            {text.large[locale]}
          </li>
        </ul>
      </div>
    )
  }
</div>
