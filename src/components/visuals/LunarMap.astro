---
/*
 * Redibujo del primer entorno de prueba del TFM (figuras 5.9 y 5.10) con el estilo de la web.
 * Los datos (mapa, obstáculos y rutas del modelo DDDQL entrenado) son los reales.
 */
import type { Locale, Localized } from '@/i18n';
import { base, grid, rovers, totalSteps, type Cell, type ScenarioMode } from '@/data/lunar-scenario';

interface Props {
  locale: Locale;
  mode: ScenarioMode;
}

const { locale, mode } = Astro.props;

const SIZE = 40;
const GAP = 3;
const VIEW = grid.length * SIZE;
const series = ['var(--series-1)', 'var(--series-2)', 'var(--series-3)'];

type Point = { x: number; y: number };
type Dir = 'H' | 'V';
const center = ([row, col]: Cell): Point => ({ x: col * SIZE + SIZE / 2, y: row * SIZE + SIZE / 2 });
const dirOf = (a: Cell, b: Cell): Dir => (a[0] === b[0] ? 'H' : 'V');

/*
 * Carriles: cada rover circula desplazado en perpendicular a su tramo para que las rutas
 * solapadas sigan viéndose. En el último tramo recto hacia la mezcladora los carriles se reparten
 * de forma simétrica entre los rovers que llegan por el mismo lado (uno solo entra por el centro,
 * es decir, por el vértice del hexágono). La salida y la mina se dibujan sobre el carril: la línea
 * nace del centro del círculo y atraviesa el rombo por sus vértices.
 */
const LANES = [-6, 0, 6];
const routes = rovers(mode);

function finalRunStart(path: Cell[]): number {
  const last = dirOf(path[path.length - 2]!, path[path.length - 1]!);
  let f = path.length - 2;
  while (f > 0 && dirOf(path[f - 1]!, path[f]!) === last) f--;
  return f;
}

/* Lado por el que llega cada rover a la mezcladora y carril simétrico dentro de su grupo. */
const approach = routes.map((r) => {
  const [a, b] = [r.path[r.path.length - 2]!, r.path[r.path.length - 1]!];
  return `${dirOf(a, b)}${Math.sign(b[0] - a[0] + b[1] - a[1])}`;
});
const finalLane = routes.map((_, i) => {
  const group = routes.map((__, j) => j).filter((j) => approach[j] === approach[i]);
  const k = group.indexOf(i);
  const spread = 5;
  return (k - (group.length - 1) / 2) * spread * 2;
});

function lanePoints(path: Cell[], lane: number, last: number): Point[] {
  const f = finalRunStart(path);
  const segs = path.slice(1).map((cell, i) => ({ dir: dirOf(path[i]!, cell), off: i >= f ? last : lane }));
  return path.map((cell, i) => {
    const c = center(cell);
    const adjacent = [segs[i - 1], segs[i]].filter((x) => x !== undefined);
    const v = adjacent.find((x) => x.dir === 'V');
    const h = adjacent.find((x) => x.dir === 'H');
    return { x: c.x + (v?.off ?? 0), y: c.y + (h?.off ?? 0) };
  });
}

const drawn = routes.map((r, i) => {
  const pts = lanePoints(r.path, LANES[i] ?? 0, finalLane[i] ?? 0);
  const mineIndex = r.path.findIndex(([row, col]) => row === r.mine[0] && col === r.mine[1]);
  return { pts, start: pts[0]!, mine: pts[mineIndex]! };
});
const toPolyline = (pts: Point[]) => pts.map(({ x, y }) => `${x},${y}`).join(' ');
const hexagon = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');

const cellFill: Record<string, string> = {
  '.': 'var(--surface)',
  s: 'color-mix(in srgb, var(--ink) 16%, var(--surface))',
  L: 'color-mix(in srgb, var(--ink) 62%, var(--surface))',
};

const steps = totalSteps(mode);
const text = {
  title: {
    es: mode === 'informed' ? 'Rutas de tres rovers que conocen sus objetivos' : 'Rutas de tres rovers que exploran para encontrar sus objetivos',
    en: mode === 'informed' ? 'Routes of three rovers that know their goals' : 'Routes of three rovers exploring to find their goals',
  },
  desc: {
    es: `Mapa lunar de 12 por 12. Cada rover va desde su salida hasta su mina y lleva el mineral a la mezcladora común. Entre los tres suman ${steps} pasos y no chocan en ningún momento.`,
    en: `A 12 by 12 lunar map. Each rover travels from its start to its mine and carries the ore to the shared mixer. Together they take ${steps} steps without a single collision.`,
  },
} satisfies Record<string, Localized>;

const id = `lunar-${mode}-${locale}`;
const b = center(base);
---

<svg viewBox={`0 0 ${VIEW} ${VIEW}`} role="img" aria-labelledby={`${id}-title ${id}-desc`} class="block h-auto w-full">
  <title id={`${id}-title`}>{text.title[locale]}</title>
  <desc id={`${id}-desc`}>{text.desc[locale]}</desc>

  <g>
    {
      grid.map((row, r) =>
        [...row].map((kind, c) => (
          <rect x={c * SIZE + GAP / 2} y={r * SIZE + GAP / 2} width={SIZE - GAP} height={SIZE - GAP} rx="4" fill={cellFill[kind]} />
        )),
      )
    }
  </g>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    {drawn.map((route, i) => <polyline points={toPolyline(route.pts)} stroke={series[i]} stroke-width="3" />)}
  </g>

  <g>
    {
      drawn.map((route, i) => {
        const s = route.start;
        const m = route.mine;
        return (
          <>
            <rect x={m.x - 9} y={m.y - 9} width="18" height="18" rx="3" transform={`rotate(45 ${m.x} ${m.y})`} fill="var(--bg)" stroke={series[i]} stroke-width="3" />
            <circle cx={s.x} cy={s.y} r="11" fill={series[i]} stroke="var(--bg)" stroke-width="3" />
            <text x={s.x} y={s.y + 4.5} text-anchor="middle" font-size="13" font-weight="700" fill="#fff">
              {i + 1}
            </text>
          </>
        );
      })
    }
    <polygon points={hexagon(b.x, b.y, 15)} fill="var(--bg)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
    <circle cx={b.x} cy={b.y} r="4" fill="var(--ink)" />
  </g>
</svg>
