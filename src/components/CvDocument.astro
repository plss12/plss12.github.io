---
/*
 * CV en formato A4, generado con los mismos datos que la web. Se imprime a PDF en el build
 * (scripts/cv-pdf.mjs). Siempre en claro, sin teléfono ni datos privados.
 */
import { routes, type Locale, type Localized } from '@/i18n';
import { formatMonth } from '@/i18n/format';
import { profile } from '@/data/profile';
import { featuredProject, projects } from '@/data/projects';
import { techExperience, internationalStage, type Role } from '@/data/experience';
import { education } from '@/data/education';
import { capabilities, toolkit } from '@/data/capabilities';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = new URL(routes.home(locale), Astro.site);

const text = {
  profile: { es: 'Perfil', en: 'Profile' },
  projects: { es: 'Proyectos destacados', en: 'Selected projects' },
  experience: { es: 'Experiencia', en: 'Experience' },
  international: { es: 'Experiencia internacional', en: 'International experience' },
  education: { es: 'Formación', en: 'Education' },
  strengths: { es: 'Especialidad', en: 'Focus areas' },
  tools: { es: 'Herramientas', en: 'Tools' },
  languages: { es: 'Idiomas', en: 'Languages' },
} satisfies Record<string, Localized>;

const period = (role: Pick<Role, 'start' | 'end'>) => `${formatMonth(role.start, locale)} – ${formatMonth(role.end, locale)}`;
const allProjects = [featuredProject, ...projects];
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<div class="cv-screen">
  <article class="cv" lang={locale === 'es' ? 'es-ES' : 'en'}>
    <header class="cv-head">
      <h1>{profile.name}</h1>
      <p class="cv-role">{profile.role[locale]}. {profile.location[locale]}</p>
      <p class="cv-contact">
        <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
        <a href={profile.links.linkedin}>{host(profile.links.linkedin)}</a>
        <a href={profile.links.github}>{host(profile.links.github)}</a>
        <a href={site.href}>{host(site.href)}</a>
      </p>
    </header>

    <section>
      <h2>{text.profile[locale]}</h2>
      <p>{profile.summary[locale]}</p>
      <p><strong>{text.strengths[locale]}:</strong> {capabilities.map((c) => c.title[locale]).join('; ')}.</p>
    </section>

    <section>
      <h2>{text.projects[locale]}</h2>
      {
        allProjects.map((project) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3>
                {project.name}
                <span class="cv-muted">, {project.context[locale]}</span>
              </h3>
              <a href={project.links[0]?.href}>{host(project.links[0]?.href ?? '')}</a>
            </div>
            <p>{project.tagline[locale]}</p>
            <p class="cv-muted">
              {project.facts.map((f) => `${f.value[locale]} ${f.label[locale]}`).join('. ')}. {project.stack.join(', ')}.
            </p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{text.experience[locale]}</h2>
      {
        techExperience.map((role) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3>
                {role.title[locale]}, {role.company}
                <span class="cv-muted">, {role.location[locale]}</span>
              </h3>
              <span class="cv-muted">{period(role)}</span>
            </div>
            <ul>
              {(role.featured ? role.highlights : role.highlights.slice(0, 1)).map((h) => (
                <li>{h[locale]}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="cv-item">
        <div class="cv-item-head">
          <h3>
            {internationalStage.title[locale]}
            <span class="cv-muted">, {internationalStage.location[locale]}</span>
          </h3>
          <span class="cv-muted">{period(internationalStage)}</span>
        </div>
        <p>{internationalStage.short[locale]}</p>
      </div>
    </section>

    <section>
      <h2>{text.education[locale]}</h2>
      {
        education.map((degree) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3>
                {degree.title[locale]}
                <span class="cv-muted">, {degree.school[locale]}</span>
              </h3>
              <span class="cv-muted">{formatMonth(degree.date, locale)}</span>
            </div>
            <ul>
              {degree.highlights.map((h) => (
                <li>{h[locale]}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <p><strong>{text.tools[locale]}:</strong> {toolkit[locale].join(', ')}.</p>
      <p>
        <strong>{text.languages[locale]}:</strong>{' '}
        {profile.languages.map((l) => `${l.name[locale]}, ${l.level[locale].replace(/\.$/, '')}.`).join(' ')}
      </p>
    </section>
  </article>
</div>

<style>
  /* El CV es siempre claro, también con el sistema en modo oscuro. */
  .cv-screen {
    --ink: #000;
    --muted: #555;
    --line: #dcdcdc;
    background: #e9e9e9;
    padding: 2rem 1rem;
    color-scheme: light;
  }

  .cv {
    box-sizing: border-box;
    width: 100%;
    max-width: 210mm;
    margin-inline: auto;
    padding: 16mm 17mm;
    background: #fff;
    color: var(--ink);
    font-size: 9.2pt;
    line-height: 1.36;
  }

  .cv a {
    color: inherit;
    text-decoration: none;
  }

  .cv-head h1 {
    font-size: 22pt;
    line-height: 1;
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: -0.01em;
  }

  .cv-role {
    margin-top: 0.35rem;
    font-size: 11pt;
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .cv section {
    margin-top: 3.4mm;
    padding-top: 2.4mm;
    border-top: 0.6pt solid var(--line);
  }

  .cv h2 {
    font-size: 10.5pt;
    font-weight: 700;
    font-stretch: 90%;
    margin-bottom: 1.5mm;
  }

  .cv h3 {
    font-weight: 600;
  }

  .cv-item {
    break-inside: avoid;
  }

  .cv-item + .cv-item {
    margin-top: 2.2mm;
  }

  .cv-item-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  .cv-item-head > :last-child {
    flex-shrink: 0;
    font-size: 8.8pt;
  }

  .cv-muted {
    color: var(--muted);
  }

  .cv ul {
    padding-left: 1rem;
    list-style: disc;
  }

  .cv li + li {
    margin-top: 0.5mm;
  }

  .cv p + p {
    margin-top: 1mm;
  }

  @page {
    size: A4;
    margin: 13mm 15mm;
  }

  @media print {
    .cv-screen {
      padding: 0;
      background: #fff;
    }

    .cv {
      max-width: none;
      padding: 0;
    }
  }
</style>
