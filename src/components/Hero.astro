---
import { getImage } from 'astro:assets';
import { sectionHref, useTranslations, type Locale } from '@/i18n';
import { profile } from '@/data/profile';
import wide from '@/assets/photos/pedro-wide.jpg';
import portrait from '@/assets/photos/pedro-portrait.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Dirección de arte: retrato vertical en móvil y panorámica en escritorio.
 * <Picture> no admite fuentes distintas por media query, así que se generan a mano.
 */
async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpeg') {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: 72 })));
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const wideWidths = [960, 1440, 1920, 2400];
const portraitWidths = [480, 720, 960, 1200];
const sources = {
  wideAvif: await srcset(wide, wideWidths, 'avif'),
  wideWebp: await srcset(wide, wideWidths, 'webp'),
  portraitAvif: await srcset(portrait, portraitWidths, 'avif'),
  portraitWebp: await srcset(portrait, portraitWidths, 'webp'),
};
const fallback = await getImage({ src: portrait, width: 720, format: 'jpeg', quality: 72 });
---

<section class="hero relative isolate overflow-hidden bg-stage text-stage-ink" aria-labelledby="hero-title">
  <picture>
    <source media="(min-width: 48rem)" type="image/avif" srcset={sources.wideAvif} sizes="(min-width: 75rem) 70vw, 85vw" />
    <source media="(min-width: 48rem)" type="image/webp" srcset={sources.wideWebp} sizes="(min-width: 75rem) 70vw, 85vw" />
    <source type="image/avif" srcset={sources.portraitAvif} sizes="100vw" />
    <source type="image/webp" srcset={sources.portraitWebp} sizes="100vw" />
    <img
      src={fallback.src}
      alt={t('hero.photoAlt')}
      width={portrait.width}
      height={portrait.height}
      fetchpriority="high"
      decoding="async"
      class="hero-photo"
    />
  </picture>

  <div class="container-page hero-copy relative">
    <h1 id="hero-title" class="text-display max-w-[11ch]">{profile.headline[locale]}</h1>
    <p class="text-lead mt-6 max-w-[34rem] text-stage-muted md:mt-8">{profile.intro[locale]}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 md:mt-10">
      <a href={sectionHref(locale, 'projects')} class="btn bg-stage-ink text-stage">{t('cta.projects')}</a>
      <a href={sectionHref(locale, 'contact')} class="link font-semibold text-stage-ink">{t('cta.contact')}</a>
    </div>
  </div>
</section>

<style>
  /* Móvil: retrato arriba que se funde con el texto. */
  .hero {
    padding-top: var(--header-h);
  }

  .hero-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 68svh;
    object-fit: cover;
    object-position: 50% 20%;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .hero-copy {
    margin-top: -4rem;
    padding-bottom: clamp(3.5rem, 10vw, 5rem);
  }

  /* Escritorio: panorámica a la derecha y titular a la izquierda, sobre el negro del estudio. */
  @media (width >= 48rem) {
    .hero {
      display: flex;
      align-items: flex-end;
      min-height: min(100svh, 56rem);
    }

    /* La foto empieza bajo la barra (no se tapa la cabeza) y se funde por la izquierda y por abajo. */
    .hero-photo {
      position: absolute;
      top: var(--header-h);
      right: 0;
      bottom: 0;
      width: 85%;
      height: calc(100% - var(--header-h));
      max-height: none;
      aspect-ratio: auto;
      object-position: 60% 0%;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 45%),
        linear-gradient(to bottom, #000 62%, transparent 100%);
      mask-composite: intersect;
      z-index: -1;
    }

    .hero-copy {
      margin-top: 0;
      padding-top: 6rem;
      padding-bottom: clamp(4rem, 9vh, 7rem);
    }
  }

  @media (width >= 75rem) {
    .hero-photo {
      width: 70%;
    }
  }
</style>
