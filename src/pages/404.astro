---
/*
 * GitHub Pages solo admite una página 404 para todo el sitio. Se renderizan las dos versiones y un
 * script mínimo (el único JS de la web) muestra la inglesa cuando la ruta pedida empieza por /en/.
 * Sin JavaScript se ve la española, que incluye un enlace a la web en inglés.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { htmlLang, routes, type Locale, type Localized } from '@/i18n';
import { profile } from '@/data/profile';

const text = {
  title: { es: 'Página no encontrada', en: 'Page not found' },
  heading: { es: 'Esta página no existe.', en: 'This page doesn’t exist.' },
  body: {
    es: 'Puede que el enlace esté mal o que la página se haya movido.',
    en: 'The link may be wrong, or the page may have moved.',
  },
  home: { es: 'Ir a la portada', en: 'Go to the home page' },
  other: { es: 'Read the site in English', en: 'Ver la web en español' },
} satisfies Record<string, Localized>;

const versions: { locale: Locale; other: Locale }[] = [
  { locale: 'es', other: 'en' },
  { locale: 'en', other: 'es' },
];
const titles = { es: `${text.title.es} | ${profile.name}`, en: `${text.title.en} | ${profile.name}` };
---

<BaseLayout locale="es" title={text.title.es} noindex bare>
  {
    versions.map(({ locale, other }) => (
      <section class="section-space" data-lang={locale} lang={htmlLang[locale]} hidden={locale === 'en'}>
        <div class="container-page">
          <a href={routes.home(locale)} class="text-[1.0625rem] font-semibold tracking-tight no-underline">
            {profile.name}
          </a>
          <h1 class="text-display mt-16 max-w-[14ch]">{text.heading[locale]}</h1>
          <p class="text-lead mt-6 max-w-prose text-muted">{text.body[locale]}</p>
          <p class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={routes.home(locale)} class="btn bg-ink text-bg">
              {text.home[locale]}
            </a>
            <a href={routes.home(other)} lang={htmlLang[other]} hreflang={htmlLang[other]} class="link font-semibold">
              {text.other[locale]}
            </a>
          </p>
        </div>
      </section>
    ))
  }
</BaseLayout>

<script is:inline define:vars={{ titles, lang: htmlLang.en }}>
  if (location.pathname.startsWith('/en/') || location.pathname === '/en') {
    document.documentElement.lang = lang;
    document.title = titles.en;
    document.querySelector('[data-lang="es"]').hidden = true;
    document.querySelector('[data-lang="en"]').hidden = false;
  }
</script>
