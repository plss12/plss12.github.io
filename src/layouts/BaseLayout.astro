---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { htmlLang, locales, ogLocale, otherLocale, routes, useTranslations, type Locale, type Localized } from '@/i18n';
import { profile } from '@/data/profile';

interface Props {
  locale: Locale;
  /** Título de la página; por defecto, el del sitio. */
  title?: string;
  description?: string;
  /** Ruta de esta misma página en cada idioma (para canonical y hreflang). */
  alternates?: Localized;
  noindex?: boolean;
  ogType?: 'website' | 'profile' | 'article';
  /** Imagen Open Graph propia (1200 × 630); por defecto, la de la portada con la foto. */
  ogImage?: { src: string; alt: string };
  /** Datos estructurados adicionales (JSON-LD). */
  schema?: Record<string, unknown>;
  /** La portada pinta su propia cabecera oscura bajo la barra. */
  overlayHeader?: boolean;
  /** Sin barra ni pie (vista imprimible del CV). */
  bare?: boolean;
}

const {
  locale,
  title,
  description,
  alternates = { es: routes.home('es'), en: routes.home('en') },
  noindex = false,
  ogType = 'profile',
  ogImage,
  schema,
  overlayHeader = false,
  bare = false,
} = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ? `${title} | ${profile.name}` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(alternates[locale], Astro.site);
const image = ogImage ?? {
  src: locale === 'es' ? '/og.jpg' : '/og-en.jpg',
  alt: `${profile.name}. ${profile.headline[locale]}`,
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role[locale],
  email: `mailto:${profile.links.email}`,
  url: new URL(routes.home(locale), Astro.site).href,
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsAbout: ['Reinforcement learning', 'Multi-agent systems', 'AI agents', 'Monte Carlo Tree Search', 'Python'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad Internacional de Valencia' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Sevilla' },
  ],
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex &&
        locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternates[l], Astro.site)} />)
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-instrument" preload />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale(locale)]} />
    <meta property="og:image" content={new URL(image.src, Astro.site)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-bg text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
      >{t('skip')}</a
    >
    {!bare && <Header locale={locale} alternates={alternates} overlay={overlayHeader} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
  </body>
</html>
